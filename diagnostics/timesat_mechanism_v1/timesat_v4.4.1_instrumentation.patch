new file mode 100644
index 0000000..f3a89b7
--- /dev/null
+++ b/fortran/erken_mechanism_diagnostic.f90
@@ -0,0 +1,190 @@
+subroutine configure_erken_mechanism_diagnostic(enabled, smoothing)
+  implicit none
+  integer, intent(in) :: enabled
+  double precision, intent(in) :: smoothing
+  integer :: diag_override_enabled, diag_curve_length, diag_error_flag
+  integer :: diag_raw_peak_count, diag_filtered_peak_count, diag_initialized_count
+  double precision :: diag_override_smoothing, diag_actual_smoothing, diag_ybase
+  double precision :: diag_coarse_curve(4096)
+  integer :: diag_raw_peaks(4096), diag_filtered_peaks(4096)
+  common /erken_mechanism_diagnostic_state/ diag_override_enabled, &
+    diag_curve_length, diag_error_flag, diag_raw_peak_count, &
+    diag_filtered_peak_count, diag_initialized_count, &
+    diag_override_smoothing, diag_actual_smoothing, diag_ybase, &
+    diag_coarse_curve, diag_raw_peaks, diag_filtered_peaks
+  save /erken_mechanism_diagnostic_state/
+
+  diag_override_enabled = enabled
+  diag_override_smoothing = smoothing
+  call clear_erken_mechanism_diagnostic()
+end subroutine configure_erken_mechanism_diagnostic
+
+subroutine clear_erken_mechanism_diagnostic()
+  implicit none
+  integer :: diag_override_enabled, diag_curve_length, diag_error_flag
+  integer :: diag_raw_peak_count, diag_filtered_peak_count, diag_initialized_count
+  double precision :: diag_override_smoothing, diag_actual_smoothing, diag_ybase
+  double precision :: diag_coarse_curve(4096)
+  integer :: diag_raw_peaks(4096), diag_filtered_peaks(4096)
+  common /erken_mechanism_diagnostic_state/ diag_override_enabled, &
+    diag_curve_length, diag_error_flag, diag_raw_peak_count, &
+    diag_filtered_peak_count, diag_initialized_count, &
+    diag_override_smoothing, diag_actual_smoothing, diag_ybase, &
+    diag_coarse_curve, diag_raw_peaks, diag_filtered_peaks
+  save /erken_mechanism_diagnostic_state/
+
+  diag_actual_smoothing = 0.d0
+  diag_ybase = 0.d0
+  diag_curve_length = 0
+  diag_error_flag = 0
+  diag_raw_peak_count = 0
+  diag_filtered_peak_count = 0
+  diag_initialized_count = 0
+  diag_coarse_curve = 0.d0
+  diag_raw_peaks = 0
+  diag_filtered_peaks = 0
+end subroutine clear_erken_mechanism_diagnostic
+
+subroutine store_erken_coarse_curve(smoothing, ybase, curve, n, error_flag)
+  implicit none
+  integer, intent(in) :: n, error_flag
+  double precision, intent(in) :: smoothing, ybase, curve(n)
+  integer :: ncopy
+  integer :: diag_override_enabled, diag_curve_length, diag_error_flag
+  integer :: diag_raw_peak_count, diag_filtered_peak_count, diag_initialized_count
+  double precision :: diag_override_smoothing, diag_actual_smoothing, diag_ybase
+  double precision :: diag_coarse_curve(4096)
+  integer :: diag_raw_peaks(4096), diag_filtered_peaks(4096)
+  common /erken_mechanism_diagnostic_state/ diag_override_enabled, &
+    diag_curve_length, diag_error_flag, diag_raw_peak_count, &
+    diag_filtered_peak_count, diag_initialized_count, &
+    diag_override_smoothing, diag_actual_smoothing, diag_ybase, &
+    diag_coarse_curve, diag_raw_peaks, diag_filtered_peaks
+  save /erken_mechanism_diagnostic_state/
+
+  ncopy = min(n, 4096)
+  diag_actual_smoothing = smoothing
+  diag_ybase = ybase
+  diag_curve_length = ncopy
+  diag_error_flag = error_flag
+  diag_coarse_curve = 0.d0
+  diag_coarse_curve(1:ncopy) = curve(1:ncopy)
+end subroutine store_erken_coarse_curve
+
+subroutine store_erken_raw_peaks(peaks, count)
+  implicit none
+  integer, intent(in) :: count, peaks(*)
+  integer :: ncopy
+  integer :: diag_override_enabled, diag_curve_length, diag_error_flag
+  integer :: diag_raw_peak_count, diag_filtered_peak_count, diag_initialized_count
+  double precision :: diag_override_smoothing, diag_actual_smoothing, diag_ybase
+  double precision :: diag_coarse_curve(4096)
+  integer :: diag_raw_peaks(4096), diag_filtered_peaks(4096)
+  common /erken_mechanism_diagnostic_state/ diag_override_enabled, &
+    diag_curve_length, diag_error_flag, diag_raw_peak_count, &
+    diag_filtered_peak_count, diag_initialized_count, &
+    diag_override_smoothing, diag_actual_smoothing, diag_ybase, &
+    diag_coarse_curve, diag_raw_peaks, diag_filtered_peaks
+  save /erken_mechanism_diagnostic_state/
+
+  ncopy = min(count, 4096)
+  diag_raw_peak_count = ncopy
+  diag_raw_peaks = 0
+  if (ncopy > 0) diag_raw_peaks(1:ncopy) = peaks(1:ncopy)
+end subroutine store_erken_raw_peaks
+
+subroutine store_erken_filtered_peaks(peaks, count)
+  implicit none
+  integer, intent(in) :: count, peaks(*)
+  integer :: ncopy
+  integer :: diag_override_enabled, diag_curve_length, diag_error_flag
+  integer :: diag_raw_peak_count, diag_filtered_peak_count, diag_initialized_count
+  double precision :: diag_override_smoothing, diag_actual_smoothing, diag_ybase
+  double precision :: diag_coarse_curve(4096)
+  integer :: diag_raw_peaks(4096), diag_filtered_peaks(4096)
+  common /erken_mechanism_diagnostic_state/ diag_override_enabled, &
+    diag_curve_length, diag_error_flag, diag_raw_peak_count, &
+    diag_filtered_peak_count, diag_initialized_count, &
+    diag_override_smoothing, diag_actual_smoothing, diag_ybase, &
+    diag_coarse_curve, diag_raw_peaks, diag_filtered_peaks
+  save /erken_mechanism_diagnostic_state/
+
+  ncopy = min(count, 4096)
+  diag_filtered_peak_count = ncopy
+  diag_filtered_peaks = 0
+  if (ncopy > 0) diag_filtered_peaks(1:ncopy) = peaks(1:ncopy)
+end subroutine store_erken_filtered_peaks
+
+subroutine store_erken_initialized_seasons(count)
+  implicit none
+  integer, intent(in) :: count
+  integer :: diag_override_enabled, diag_curve_length, diag_error_flag
+  integer :: diag_raw_peak_count, diag_filtered_peak_count, diag_initialized_count
+  double precision :: diag_override_smoothing, diag_actual_smoothing, diag_ybase
+  double precision :: diag_coarse_curve(4096)
+  integer :: diag_raw_peaks(4096), diag_filtered_peaks(4096)
+  common /erken_mechanism_diagnostic_state/ diag_override_enabled, &
+    diag_curve_length, diag_error_flag, diag_raw_peak_count, &
+    diag_filtered_peak_count, diag_initialized_count, &
+    diag_override_smoothing, diag_actual_smoothing, diag_ybase, &
+    diag_coarse_curve, diag_raw_peaks, diag_filtered_peaks
+  save /erken_mechanism_diagnostic_state/
+
+  diag_initialized_count = count
+end subroutine store_erken_initialized_seasons
+
+subroutine get_erken_mechanism_diagnostic(actual_smoothing, ybase, curve_length, &
+    error_flag, raw_peak_count, filtered_peak_count, initialized_season_count, &
+    coarse_curve, raw_peaks, filtered_peaks)
+  implicit none
+  double precision, intent(out) :: actual_smoothing, ybase
+  integer, intent(out) :: curve_length, error_flag, raw_peak_count
+  integer, intent(out) :: filtered_peak_count, initialized_season_count
+  double precision, intent(out) :: coarse_curve(4096)
+  integer, intent(out) :: raw_peaks(4096), filtered_peaks(4096)
+  integer :: diag_override_enabled, diag_curve_length, diag_error_flag
+  integer :: diag_raw_peak_count, diag_filtered_peak_count, diag_initialized_count
+  double precision :: diag_override_smoothing, diag_actual_smoothing, diag_ybase
+  double precision :: diag_coarse_curve(4096)
+  integer :: diag_raw_peaks(4096), diag_filtered_peaks(4096)
+  common /erken_mechanism_diagnostic_state/ diag_override_enabled, &
+    diag_curve_length, diag_error_flag, diag_raw_peak_count, &
+    diag_filtered_peak_count, diag_initialized_count, &
+    diag_override_smoothing, diag_actual_smoothing, diag_ybase, &
+    diag_coarse_curve, diag_raw_peaks, diag_filtered_peaks
+  save /erken_mechanism_diagnostic_state/
+
+  actual_smoothing = diag_actual_smoothing
+  ybase = diag_ybase
+  curve_length = diag_curve_length
+  error_flag = diag_error_flag
+  raw_peak_count = diag_raw_peak_count
+  filtered_peak_count = diag_filtered_peak_count
+  initialized_season_count = diag_initialized_count
+  coarse_curve = diag_coarse_curve
+  raw_peaks = diag_raw_peaks
+  filtered_peaks = diag_filtered_peaks
+end subroutine get_erken_mechanism_diagnostic
+
+block data initialize_erken_mechanism_diagnostic
+  implicit none
+  integer :: diag_override_enabled, diag_curve_length, diag_error_flag
+  integer :: diag_raw_peak_count, diag_filtered_peak_count, diag_initialized_count
+  double precision :: diag_override_smoothing, diag_actual_smoothing, diag_ybase
+  double precision :: diag_coarse_curve(4096)
+  integer :: diag_raw_peaks(4096), diag_filtered_peaks(4096)
+  common /erken_mechanism_diagnostic_state/ diag_override_enabled, &
+    diag_curve_length, diag_error_flag, diag_raw_peak_count, &
+    diag_filtered_peak_count, diag_initialized_count, &
+    diag_override_smoothing, diag_actual_smoothing, diag_ybase, &
+    diag_coarse_curve, diag_raw_peaks, diag_filtered_peaks
+  data diag_override_enabled /0/
+  data diag_override_smoothing /1000.d0/
+  data diag_actual_smoothing /0.d0/
+  data diag_ybase /0.d0/
+  data diag_curve_length /0/
+  data diag_error_flag /0/
+  data diag_raw_peak_count /0/
+  data diag_filtered_peak_count /0/
+  data diag_initialized_count /0/
+end block data initialize_erken_mechanism_diagnostic
